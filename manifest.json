{
  "manifest_version": 3,
  "name": "PageMortem",
  "version": "0.4.0",
  "description": "Ask, summarize, translate and automate pages with your own LAN-hosted model. No other network access.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pagemortem@middlepathlabs.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "menus",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "downloads",
    "notifications"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "PageMortem",
    "default_icon": "icons/icon.svg"
  },
  "sidebar_action": {
    "default_title": "PageMortem",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Toggle the PageMortem sidebar"
    }
  }
}
